{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "repartidores": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "pedidos": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["estado"],
      "$token": {
        ".read": true,
        ".write": "auth != null && root.child('repartidores').child(auth.uid).exists()",
        "estado": {
          ".validate": "newData.val() === 'en_ruta' || newData.val() === 'entregado' || newData.val() === 'cancelado'"
        }
      }
    }
  }
}
