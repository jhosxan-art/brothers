            },
            "lat": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "lng": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "texto": {
              ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 200"
            },
            "$otro": {
              ".validate": false
            }
          },
          "$otro": {
            ".validate": false
          }
        },
        "clienteGps": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'anonymous' && $solicitudId.matches(/^sol_[A-Za-z0-9_-]{8,64}$/) && (root.child('solicitudes_entrantes').child($solicitudId).child('estado').val() === 'nuevo' || root.child('solicitudes_entrantes').child($solicitudId).child('estado').val() === 'atendido')",
          ".validate": "newData.hasChildren(['lat', 'lng', 'ts']) && newData.child('lat').isNumber() && newData.child('lat').val() >= -90 && newData.child('lat').val() <= 90 && newData.child('lng').isNumber() && newData.child('lng').val() >= -180 && newData.child('lng').val() <= 180 && newData.child('ts').isNumber() && newData.child('ts').val() <= now",
          "lat": {},
          "lng": {},
          "ts": {},
          "prec": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$otro": {
            ".validate": false
          }
        },
        "repartidorGps": {
          ".write": "auth != null && (root.child('repartidores').child(auth.uid).exists() && root.child('solicitudes_entrantes').child($solicitudId).child('repartidorUid').val() === auth.uid && root.child('solicitudes_entrantes').child($solicitudId).child('estado').val() === 'atendido')",
          ".validate": "newData.hasChildren(['lat', 'lng', 'ts']) && newData.child('lat').isNumber() && newData.child('lat').val() >= -90 && newData.child('lat').val() <= 90 && newData.child('lng').isNumber() && newData.child('lng').val() >= -180 && newData.child('lng').val() <= 180 && newData.child('ts').isNumber() && newData.child('ts').val() <= now",
          "lat": {},
          "lng": {},
          "ts": {},
          "rumbo": {
            ".validate": "newData.isNumber()"
          },
          "$otro": {
            ".validate": false
          }
        },
        "valoracion": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'anonymous' && $solicitudId.matches(/^sol_[A-Za-z0-9_-]{8,64}$/) && !data.exists() && root.child('solicitudes_entrantes').child($solicitudId).child('estado').val() === 'entregado'",
          ".validate": "newData.hasChildren(['estrellas', 'ts']) && newData.child('estrellas').isNumber() && newData.child('estrellas').val() >= 1 && newData.child('estrellas').val() <= 5 && newData.child('estrellas').val() % 1 === 0 && newData.child('ts').val() === now",
          "estrellas": {},
          "ts": {},
          "$otro": {
            ".validate": false
          }
        },
        "facturaFinal": {
          ".write": "auth != null && (root.child('repartidores').child(auth.uid).exists() && root.child('solicitudes_entrantes').child($solicitudId).child('repartidorUid').val() === auth.uid && root.child('solicitudes_entrantes').child($solicitudId).child('estado').val() === 'atendido')",
          ".validate": "newData.hasChildren(['productos', 'totalFinal']) && newData.child('totalFinal').isNumber()"
        },
        "subfactura": {
          ".write": "auth != null && (root.child('repartidores').child(auth.uid).exists() && root.child('solicitudes_entrantes').child($solicitudId).child('repartidorUid').val() === auth.uid && root.child('solicitudes_entrantes').child($solicitudId).child('estado').val() === 'atendido')",
          ".validate": "newData.hasChildren(['ts'])"
        },
        "ultimoMensaje": {
          ".write": "auth != null && ((auth.token.firebase.sign_in_provider === 'anonymous' && $solicitudId.matches(/^sol_[A-Za-z0-9_-]{8,64}$/) && root.child('solicitudes_entrantes').child($solicitudId).child('estado').val() === 'atendido' && newData.isString()) || (root.child('repartidores').child(auth.uid).exists() && root.child('solicitudes_entrantes').child($solicitudId).child('repartidorUid').val() === auth.uid && root.child('solicitudes_entrantes').child($solicitudId).child('estado').val() === 'atendido'))",
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "ultimoDe": {
          ".write": "auth != null && ((auth.token.firebase.sign_in_provider === 'anonymous' && $solicitudId.matches(/^sol_[A-Za-z0-9_-]{8,64}$/) && root.child('solicitudes_entrantes').child($solicitudId).child('estado').val() === 'atendido' && newData.val() === 'cliente') || ((root.child('repartidores').child(auth.uid).exists() && root.child('solicitudes_entrantes').child($solicitudId).child('repartidorUid').val() === auth.uid && root.child('solicitudes_entrantes').child($solicitudId).child('estado').val() === 'atendido') && newData.val() === 'repartidor'))",
          ".validate": "newData.val() === '' || newData.val() === 'cliente' || newData.val() === 'repartidor'"
        },
        "ts": {
          ".write": "auth != null && ((auth.token.firebase.sign_in_provider === 'anonymous' && $solicitudId.matches(/^sol_[A-Za-z0-9_-]{8,64}$/) && root.child('solicitudes_entrantes').child($solicitudId).child('estado').val() === 'atendido' && newData.isNumber() && newData.val() <= now) || ((root.child('repartidores').child(auth.uid).exists() && root.child('solicitudes_entrantes').child($solicitudId).child('repartidorUid').val() === auth.uid && root.child('solicitudes_entrantes').child($solicitudId).child('estado').val() === 'atendido') && newData.isNumber() && newData.val() <= now))",
          ".validate": "newData.isNumber()"
        },
        "mensajes": {
          "$id": {
            ".write": "auth != null && !data.exists() && newData.exists() && ((auth.token.firebase.sign_in_provider === 'anonymous' && $solicitudId.matches(/^sol_[A-Za-z0-9_-]{8,64}$/) && root.child('solicitudes_entrantes').child($solicitudId).child('estado').val() === 'atendido' && newData.child('de').val() === 'cliente') || ((root.child('repartidores').child(auth.uid).exists() && root.child('solicitudes_entrantes').child($solicitudId).child('repartidorUid').val() === auth.uid && root.child('solicitudes_entrantes').child($solicitudId).child('estado').val() === 'atendido') && newData.child('de').val() === 'repartidor'))",
            ".validate": "newData.hasChildren(['de', 'tipo', 'ts']) && (newData.child('de').val() === 'cliente' || newData.child('de').val() === 'repartidor') && (newData.child('de').val() !== 'cliente' || auth.token.firebase.sign_in_provider === 'anonymous') && (newData.child('de').val() !== 'repartidor' || auth.token.firebase.sign_in_provider !== 'anonymous') && (newData.child('tipo').val() === 'texto' || newData.child('tipo').val() === 'factura' || newData.child('tipo').val() === 'foto') && (newData.child('tipo').val() !== 'texto' || (newData.child('texto').isString() && newData.child('texto').val().length >= 1 && newData.child('texto').val().length <= 600)) && (newData.child('tipo').val() !== 'factura' || newData.child('factura').hasChildren(['productos', 'totalFinal']))",
            "de": {
              ".validate": "newData.isString()"
            },
            "tipo": {
              ".validate": "newData.isString()"
            },
            "texto": {
              ".validate": "newData.isString() && newData.val().length <= 600"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "factura": {},
            "$otro": {
              ".validate": false
            }
          }
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "configuracion": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('repartidores').child(auth.uid).exists())",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "actualizaciones": {
        "$app": {
          ".validate": "newData.hasChildren(['version']) && newData.child('version').isNumber()",
          "version": {},
          "novedades": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "url": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "publicado": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "solicitudes_fotos": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('repartidores').child(auth.uid).exists())",
      "$solicitudId": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'anonymous' && $solicitudId.matches(/^sol_[A-Za-z0-9_-]{8,64}$/)",
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        "$fotoId": {
          ".write": "auth != null && !data.exists() && newData.isString() && ((auth.token.firebase.sign_in_provider === 'anonymous' && $solicitudId.matches(/^sol_[A-Za-z0-9_-]{8,64}$/) && root.child('solicitudes_entrantes').child($solicitudId).child('estado').val() === 'atendido') || (root.child('repartidores').child(auth.uid).exists() && root.child('solicitudes_entrantes').child($solicitudId).child('repartidorUid').val() === auth.uid && root.child('solicitudes_entrantes').child($solicitudId).child('estado').val() === 'atendido'))",
          ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 400000"
        }
      }
    },
    "facturas_historial": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$dia": {
        ".validate": "$dia.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        "$solicitudId": {
          ".validate": "newData.hasChildren(['repartidorUid', 'totalFinal', 'orden', 'ts'])",
          ".write": "auth != null && !data.exists() && root.child('repartidores').child(auth.uid).exists() && $solicitudId.matches(/^sol_[A-Za-z0-9_-]{8,64}$/) && root.child('solicitudes_entrantes').child($solicitudId).child('estado').val() === 'entregado' && root.child('solicitudes_entrantes').child($solicitudId).child('repartidorUid').val() === auth.uid && newData.child('repartidorUid').val() === auth.uid",
          "repartidorUid": {
            ".validate": "newData.isString()"
          },
          "repartidorNombre": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
