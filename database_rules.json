            ".write": "auth != null && (root.child('repartidores').child(auth.uid).exists() && root.child('solicitudes_entrantes').child($solicitudId).child('repartidorUid').val() === auth.uid && root.child('solicitudes_entrantes').child($solicitudId).child('estado').val() === 'atendido')",
            ".validate": "newData.val() === true && $uid === auth.uid"
          }
        },
        "pedido": {
          ".validate": "newData.hasChildren(['quiere', 'origen', 'modo', 'destino'])",
