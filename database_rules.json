              }
            }
          },
          "subtotal": {
            ".validate": "newData.isNumber()"
          },
          "delivery": {
            ".validate": "newData.isNumber()"
          },
          "extras": {
            ".validate": "newData.isNumber()"
          },
          "totalFinal": {
            ".validate": "newData.isNumber()"
          },
          "orden": {
